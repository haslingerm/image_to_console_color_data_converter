<MudFileUpload T="IBrowserFile" FilesChanged="HandleFileChanged" Accept=".png,.jpg"
               @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
    <CustomContent Context="upload">
        <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Image"
                Label="Load image (.jpg, .png)"
                OnClick="@(upload.OpenFilePickerAsync)" />
    </CustomContent>
</MudFileUpload>

@code {
        
        private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private const int MaxFileSize = 1024 * 1024 * 25; // 25MB
    
    private string _dragClass = DefaultDragClass;
    private static readonly string[] allowedExtensions = { ".jpg", ".png" };

    /// <summary>Raised with the image's data URL (data:image/...;base64,...) once a valid file is chosen.</summary>
    [Parameter]
    public EventCallback<string> ImageUploaded { get; set; }

    private async Task HandleFileChanged(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }
        if (!allowedExtensions.Any(ext => file.Name.EndsWith(ext, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }
        await using var stream = file.OpenReadStream(MaxFileSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        // Build a data URL and pass it straight to the parent.
        // The actual image decoding + resizing is done in JS via the Canvas API.
        var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        await ImageUploaded.InvokeAsync(dataUrl);
    }

    private void SetDragClass()
    {
        _dragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        _dragClass = DefaultDragClass;
    }

}